{
  "format": "kerp-form-conformance/1",
  "description": "Shared form-template cases. Every case runs on the server engine (backend/app/core/fields) and the client engine (frontend/src/shells/form); both must return exactly `expected`. Schema: tests/contract/README.md.",
  "evaluator_version": 1,
  "unlinted_templates": ["failclosed"],
  "templates": {
    "coating": {"default_language": "en", "fields": [{"field_key": "substrate_type", "label": "Substrate type", "data_type": "select", "required": true, "options": [{"value": "STRUCTURAL_STEEL", "label": {"en": "Structural steel", "de": "Baustahl"}}, {"value": "CONCRETE", "label": "Concrete"}]}, {"field_key": "coating_system", "label": "Coating system", "data_type": "text"}, {"field_key": "coating_adhesion_psi", "label": "Coating adhesion psi", "data_type": "number", "required": true, "visible_if": "fields.substrate_type == 'STRUCTURAL_STEEL' && fields.coating_system == 'SYSTEM_5_EPOXY'", "validation": {"cel_expression": "fields.coating_adhesion_psi >= 1450.0", "error_message": "Minimum allowable threshold is 1450 PSI."}}, {"field_key": "remarks", "label": "Remarks", "data_type": "text", "required_if": "fields.substrate_type == 'CONCRETE'"}], "sections": [{"section_key": "surface", "title": {"en": "Surface"}, "fields": ["substrate_type", "coating_system"]}]},
    "dft": {"fields": [{"field_key": "dft_1", "label": "Dft 1", "data_type": "numeric", "required": true, "range": {"min": 0}}, {"field_key": "dft_2", "label": "Dft 2", "data_type": "numeric", "required": true, "range": {"min": 0}}, {"field_key": "dft_3", "label": "Dft 3", "data_type": "numeric", "required": true, "range": {"min": 0}}, {"field_key": "dft_avg", "label": "Dft avg", "data_type": "calculated", "expression": "(fields.dft_1 + fields.dft_2 + fields.dft_3) / 3.0", "range": {"min": "asset.attributes.dft_min", "max": "asset.attributes.dft_max"}}, {"field_key": "dft_ok", "label": "Dft ok", "data_type": "calculated", "expression": "fields.dft_avg >= asset.attributes.dft_min && fields.dft_avg <= asset.attributes.dft_max"}, {"field_key": "ncr_note", "label": "Ncr note", "data_type": "text", "required": true, "visible_if": "fields.dft_ok == false"}]},
    "palette": {"fields": [{"field_key": "thickness", "label": "Thickness", "data_type": "measurement", "units": ["mm", "in"], "range": {"min": 5.8, "max": 12}}, {"field_key": "photos", "label": "Photos", "data_type": "photo", "required": true}, {"field_key": "sign", "label": "Sign", "data_type": "signature"}, {"field_key": "gauge", "label": "Gauge", "data_type": "instrument_ref"}, {"field_key": "done", "label": "Done", "data_type": "boolean", "required": true}, {"field_key": "inspected_on", "label": "Inspected on", "data_type": "date", "validation": {"cel_expression": "fields.inspected_on <= device.today", "error_message": "Not in the future."}}, {"field_key": "grade", "label": "Grade", "data_type": "select", "options": [{"value": "A", "label": "A"}, {"value": "B", "label": "B"}]}, {"field_key": "count", "label": "Count", "data_type": "numeric", "required": true}, {"field_key": "note", "label": "Note", "data_type": "text", "validation": {"cel_expression": "size(fields.note) <= 3", "error_message": "At most 3 characters."}}]},
    "cycle": {"fields": [{"field_key": "a", "label": "A", "data_type": "numeric", "visible_if": "!has(fields.b)"}, {"field_key": "b", "label": "B", "data_type": "numeric", "visible_if": "has(fields.a)"}, {"field_key": "c", "label": "C", "data_type": "text", "visible_if": "has(fields.b)"}, {"field_key": "d", "label": "D", "data_type": "text"}]},
    "chain": {"fields": [{"field_key": "gate", "label": "Gate", "data_type": "boolean"}, {"field_key": "level_1", "label": "Level 1", "data_type": "text", "visible_if": "has(fields.gate) && fields.gate"}, {"field_key": "level_2", "label": "Level 2", "data_type": "text", "visible_if": "has(fields.level_1)"}, {"field_key": "total", "label": "Total", "data_type": "calculated", "expression": "has(fields.level_2) ? 2.0 : 1.0", "visible_if": "has(fields.level_1)"}, {"field_key": "constructor", "label": "Constructor", "data_type": "text", "visible_if": "has(fields.total)"}, {"field_key": "needs_proto", "label": "Needs proto", "data_type": "text", "visible_if": "has(fields.constructor)"}]},
    "failclosed": {"fields": [{"field_key": "x", "label": "X", "data_type": "numeric"}, {"field_key": "shown_if_non_bool", "label": "Shown if non bool", "data_type": "text", "visible_if": "fields.x"}, {"field_key": "required_if_non_bool", "label": "Required if non bool", "data_type": "text", "required_if": "fields.x"}, {"field_key": "required_if_absent", "label": "Required if absent", "data_type": "text", "required_if": "fields.missing == 1.0"}, {"field_key": "optional_if_false", "label": "Optional if false", "data_type": "text", "required_if": "has(fields.missing)"}, {"field_key": "valid_if_non_bool", "label": "Valid if non bool", "data_type": "text", "validation": {"cel_expression": "fields.x", "error_message": "never shown"}}, {"field_key": "valid_if_parse_error", "label": "Valid if parse error", "data_type": "text", "validation": {"cel_expression": "fields.x >", "error_message": "never shown"}}, {"field_key": "calc_absent", "label": "Calc absent", "data_type": "calculated", "expression": "fields.missing * 2.0"}, {"field_key": "calc_text", "label": "Calc text", "data_type": "calculated", "expression": "'n/a'", "range": {"max": 1}}, {"field_key": "calc_null", "label": "Calc null", "data_type": "calculated", "expression": "null", "required": true}, {"field_key": "calc_int", "label": "Calc int", "data_type": "calculated", "expression": "size([1, 2])", "range": {"min": 0}}, {"field_key": "calc_forward", "label": "Calc forward", "data_type": "calculated", "expression": "fields.calc_last + 1.0"}, {"field_key": "calc_last", "label": "Calc last", "data_type": "calculated", "expression": "1.0"}, {"field_key": "range_bad_bound", "label": "Range bad bound", "data_type": "numeric", "range": {"min": "fields.missing", "max": 10}}, {"field_key": "range_text_bound", "label": "Range text bound", "data_type": "numeric", "range": {"max": "'ten'"}}, {"field_key": "range_nan_bound", "label": "Range nan bound", "data_type": "numeric", "range": {"min": "0.0 / 0.0"}}, {"field_key": "unknown_type", "label": "Unknown type", "data_type": "barcode"}]}
  },
  "cases": [
    {"name": "coating: empty form; required_if on an unanswered field fails closed (required)", "template": "coating", "values": {}, "context": {}, "expected": {"visible": ["substrate_type", "coating_system", "remarks"], "values": {}, "required": ["substrate_type", "remarks"], "failed": [], "errors": {"substrate_type": {"kind": "required"}, "remarks": {"kind": "required"}}}},
    {"name": "coating: visible_if true shows the field, required and valid", "template": "coating", "values": {"substrate_type": "STRUCTURAL_STEEL", "coating_system": "SYSTEM_5_EPOXY", "coating_adhesion_psi": 1500}, "context": {}, "expected": {"visible": ["substrate_type", "coating_system", "coating_adhesion_psi", "remarks"], "values": {"substrate_type": "STRUCTURAL_STEEL", "coating_system": "SYSTEM_5_EPOXY", "coating_adhesion_psi": 1500}, "required": ["substrate_type", "coating_adhesion_psi"], "failed": [], "errors": {}}},
    {"name": "coating: validation false is invalid", "template": "coating", "values": {"substrate_type": "STRUCTURAL_STEEL", "coating_system": "SYSTEM_5_EPOXY", "coating_adhesion_psi": 1320.5}, "context": {}, "expected": {"visible": ["substrate_type", "coating_system", "coating_adhesion_psi", "remarks"], "values": {"substrate_type": "STRUCTURAL_STEEL", "coating_system": "SYSTEM_5_EPOXY", "coating_adhesion_psi": 1320.5}, "required": ["substrate_type", "coating_adhesion_psi"], "failed": [], "errors": {"coating_adhesion_psi": {"kind": "invalid"}}}},
    {"name": "coating: a hidden field's answer is dropped", "template": "coating", "values": {"substrate_type": "CONCRETE", "coating_system": "SYSTEM_5_EPOXY", "coating_adhesion_psi": 1500, "remarks": "primer"}, "context": {}, "expected": {"visible": ["substrate_type", "coating_system", "remarks"], "values": {"substrate_type": "CONCRETE", "coating_system": "SYSTEM_5_EPOXY", "remarks": "primer"}, "required": ["substrate_type", "remarks"], "failed": [], "errors": {}}},
    {"name": "coating: required_if true and unanswered", "template": "coating", "values": {"substrate_type": "CONCRETE"}, "context": {}, "expected": {"visible": ["substrate_type", "coating_system", "remarks"], "values": {"substrate_type": "CONCRETE"}, "required": ["substrate_type", "remarks"], "failed": [], "errors": {"remarks": {"kind": "required"}}}},
    {"name": "coating: visible_if on an unanswered field fails closed (hidden)", "template": "coating", "values": {"substrate_type": "STRUCTURAL_STEEL"}, "context": {}, "expected": {"visible": ["substrate_type", "coating_system", "remarks"], "values": {"substrate_type": "STRUCTURAL_STEEL"}, "required": ["substrate_type"], "failed": [], "errors": {}}},
    {"name": "coating: null and '' are unanswered", "template": "coating", "values": {"substrate_type": null, "coating_system": "", "remarks": null}, "context": {}, "expected": {"visible": ["substrate_type", "coating_system", "remarks"], "values": {}, "required": ["substrate_type", "remarks"], "failed": [], "errors": {"substrate_type": {"kind": "required"}, "remarks": {"kind": "required"}}}},
    {"name": "coating: an option that is not offered is a type mismatch", "template": "coating", "values": {"substrate_type": "TIMBER"}, "context": {}, "expected": {"visible": ["substrate_type", "coating_system", "remarks"], "values": {"substrate_type": "TIMBER"}, "required": ["substrate_type"], "failed": [], "errors": {"substrate_type": {"kind": "type_mismatch"}}}},
    {"name": "coating: answers for unknown keys are ignored", "template": "coating", "values": {"substrate_type": "CONCRETE", "remarks": "x", "injected": 1}, "context": {}, "expected": {"visible": ["substrate_type", "coating_system", "remarks"], "values": {"substrate_type": "CONCRETE", "remarks": "x"}, "required": ["substrate_type", "remarks"], "failed": [], "errors": {}}},
    {"name": "coating: context cannot replace fields", "template": "coating", "values": {"substrate_type": "CONCRETE", "remarks": "x"}, "context": {"fields": {"substrate_type": "STRUCTURAL_STEEL", "coating_system": "SYSTEM_5_EPOXY"}}, "expected": {"visible": ["substrate_type", "coating_system", "remarks"], "values": {"substrate_type": "CONCRETE", "remarks": "x"}, "required": ["substrate_type", "remarks"], "failed": [], "errors": {}}},
    {"name": "dft: average in range", "template": "dft", "values": {"dft_1": 250, "dft_2": 262.5, "dft_3": 241}, "context": {"asset": {"attributes": {"dft_min": 240, "dft_max": 260}}}, "expected": {"visible": ["dft_1", "dft_2", "dft_3", "dft_avg", "dft_ok"], "values": {"dft_1": 250, "dft_2": 262.5, "dft_3": 241, "dft_avg": 251.16666666666666, "dft_ok": true}, "required": ["dft_1", "dft_2", "dft_3"], "failed": [], "errors": {}}},
    {"name": "dft: average out of range is flagged failed and opens the NCR note", "template": "dft", "values": {"dft_1": 200, "dft_2": 210, "dft_3": 220}, "context": {"asset": {"attributes": {"dft_min": 240, "dft_max": 260}}}, "expected": {"visible": ["dft_1", "dft_2", "dft_3", "dft_avg", "dft_ok", "ncr_note"], "values": {"dft_1": 200, "dft_2": 210, "dft_3": 220, "dft_avg": 210.0, "dft_ok": false}, "required": ["dft_1", "dft_2", "dft_3", "ncr_note"], "failed": ["dft_avg"], "errors": {"ncr_note": {"kind": "required"}}}},
    {"name": "dft: a submitted calculated value is ignored", "template": "dft", "values": {"dft_1": 250, "dft_2": 250, "dft_3": 250, "dft_avg": 9999, "dft_ok": false, "ncr_note": "forged"}, "context": {"asset": {"attributes": {"dft_min": 240, "dft_max": 260}}}, "expected": {"visible": ["dft_1", "dft_2", "dft_3", "dft_avg", "dft_ok"], "values": {"dft_1": 250, "dft_2": 250, "dft_3": 250, "dft_avg": 250.0, "dft_ok": true}, "required": ["dft_1", "dft_2", "dft_3"], "failed": [], "errors": {}}},
    {"name": "dft: a missing reading fails the calculations closed", "template": "dft", "values": {"dft_1": 250, "dft_2": 262.5}, "context": {"asset": {"attributes": {"dft_min": 240, "dft_max": 260}}}, "expected": {"visible": ["dft_1", "dft_2", "dft_3", "dft_avg", "dft_ok"], "values": {"dft_1": 250, "dft_2": 262.5}, "required": ["dft_1", "dft_2", "dft_3"], "failed": [], "errors": {"dft_3": {"kind": "required"}, "dft_avg": {"kind": "rule_error", "code": "NO_SUCH_KEY"}, "dft_ok": {"kind": "rule_error", "code": "NO_SUCH_KEY"}}}},
    {"name": "dft: a missing context variable fails closed", "template": "dft", "values": {"dft_1": 250, "dft_2": 250, "dft_3": 250}, "context": {}, "expected": {"visible": ["dft_1", "dft_2", "dft_3", "dft_avg", "dft_ok"], "values": {"dft_1": 250, "dft_2": 250, "dft_3": 250, "dft_avg": 250.0}, "required": ["dft_1", "dft_2", "dft_3"], "failed": [], "errors": {"dft_avg": {"kind": "rule_error", "code": "UNDECLARED_REFERENCE"}, "dft_ok": {"kind": "rule_error", "code": "UNDECLARED_REFERENCE"}}}},
